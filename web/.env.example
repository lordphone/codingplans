# Copy to web/.env for local builds. All values are public (shipped as static HTML).
#
# Supabase project URL and anon/publishable key (read-only via RLS).
# If either is empty and PUBLIC_DATA_SOURCE is not "fixtures", the site builds
# with empty states ("No measurements published yet").
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Set to "fixtures" to build from src/lib/data/fixtures.ts (sample data, shows a banner).
PUBLIC_DATA_SOURCE=
