# Copy to .env (git-ignored). An audit needs BOTH keys of a pair: the official
# pay-per-token API (reference) and the coding plan (target). See README.md.

# Official references (pay-per-token)
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
MIMO_API_KEY=
STEPFUN_API_KEY=

# Coding plans (flat-rate subscriptions under audit)
ZAI_CODING_PLAN_API_KEY=
KIMI_CODE_API_KEY=
MINIMAX_M_PLAN_API_KEY=
ALIBABA_CLOUD_MODEL_STUDIO_CODING_PLAN_API_KEY=
MIMO_TOKEN_PLAN_API_KEY=
STEP_PLAN_API_KEY=
ARK_CODING_PLAN_API_KEY=
OPENCODE_GO_API_KEY=
SYNTHETIC_API_KEY=
CHUTES_API_KEY=
OLLAMA_API_KEY=
CEREBRAS_API_KEY=

# Lab only: Hugging Face token for model downloads (public Qwen models work without it)
HF_TOKEN=

# Optional overrides
# PLANAUDIT_VLLM=~/.venvs/codingplans-lab/bin/vllm      # vLLM binary used by `planaudit lab`
# PLANAUDIT_SANDBOX=docker|process|auto                  # how the code probe runs generated code
# PLANAUDIT_<SLUG>_BASE_URL= / PLANAUDIT_<SLUG>_MODEL=   # per-endpoint overrides
