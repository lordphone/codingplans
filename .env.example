# Copy to `.env` in the repo root. Real `.env` is gitignored.
# python-dotenv loads it for everything under benchmarks/.
# Which key feeds which endpoint, where to get it, and the ToS caveats:
# docs/REQUIREMENTS.md. Leave a key blank to skip the endpoints that need it.

# --- Official pay-as-you-go APIs (references) ---------------------------------
ZAI_API_KEY=
MOONSHOT_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=

# --- Coding plans (audit targets) ----------------------------------------------
ALIBABA_CLOUD_MODEL_STUDIO_CODING_PLAN_API_KEY=
ZAI_CODING_PLAN_API_KEY=
KIMI_CODE_API_KEY=
MINIMAX_M_PLAN_API_KEY=

# --- Supabase (only for --ingest; service role bypasses RLS: never ship it) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional per-endpoint overrides --------------------------------------------
# <SLUG>_BASE_URL / <SLUG>_MODEL, slug upper-cased with '-' and '.' -> '_', e.g.
# GLM5_OFFICIAL_BASE_URL=https://api.z.ai/api/paas/v4
# KIMI_K3_KIMI_CODE_MODEL=kimi-for-coding
