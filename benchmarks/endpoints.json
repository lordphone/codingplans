{
  "_comment": [
    "Single registry of every chat endpoint the audit touches, plus which plan endpoints are audited against which official reference.",
    "Endpoint fields: base_url (OpenAI-compatible root), api_key_env, model (API model id), role (official | plan),",
    "thinking.on / thinking.off (request params that enable/disable reasoning; null = cannot be toggled),",
    "extra_params (merged into every request), honest_user_agent (true = send our own UA instead of rotating IDE UAs;",
    "required where the plan's ToS treats UA changes as a violation), verified (false = ids/URLs taken from docs, not yet",
    "confirmed by benchmarks/audit/preflight.py).",
    "Every base_url / model can be overridden at runtime with <SLUG>_BASE_URL / <SLUG>_MODEL (slug upper-cased, '-' and '.' -> '_')."
  ],
  "endpoints": {
    "glm5-official": {
      "role": "official",
      "base_url": "https://api.z.ai/api/paas/v4",
      "api_key_env": "ZAI_API_KEY",
      "model": "glm-5",
      "thinking": { "on": { "thinking": { "type": "enabled" } }, "off": { "thinking": { "type": "disabled" } } },
      "verified": false
    },
    "glm5-alibaba": {
      "role": "plan",
      "base_url": "https://coding-intl.dashscope.aliyuncs.com/v1",
      "api_key_env": "ALIBABA_CLOUD_MODEL_STUDIO_CODING_PLAN_API_KEY",
